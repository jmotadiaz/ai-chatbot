[Unit]
Description=Model Gateway (LiteLLM Proxy stateless + FastAPI catalog)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# UID transitorio por arranque: ningún otro proceso del host (incluidos los
# agentes que corren como el usuario operador) puede leer el
# $CREDENTIALS_DIRECTORY de esta unidad, aunque comparta "usuario lógico".
# Consecuencia: el servicio NO puede leer /home/<operador>, por eso el
# instalador copia el paquete a /opt/model-gateway (ver scripts/install-service.sh).
DynamicUser=yes
WorkingDirectory=/opt/model-gateway

# LiteLLM carga config.yaml de esta variable (litellm.proxy.proxy_server lee
# CONFIG_FILE_PATH); sin ella el proxy montaría sin model_list ni master_key.
Environment=CONFIG_FILE_PATH=/opt/model-gateway/config.yaml
# HOME escribible para cachés/logs de LiteLLM; %S lo crea StateDirectory ya
# con el UID transitorio como dueño.
Environment=HOME=%S/model-gateway
Environment=PYTHONDONTWRITEBYTECODE=1

StateDirectory=model-gateway
CacheDirectory=model-gateway

ExecStart=/usr/bin/env bash /opt/model-gateway/scripts/run-gateway.sh
Restart=on-failure
RestartSec=5

# Encrypted credentials (systemd-creds), decrypted into $CREDENTIALS_DIRECTORY.
# run-gateway.sh exports them as ephemeral process environment variables.
LoadCredentialEncrypted=model_gateway_api_key:/etc/model-gateway/creds/model_gateway_api_key.cred
LoadCredentialEncrypted=opencode_api_key:/etc/model-gateway/creds/opencode_api_key.cred
LoadCredentialEncrypted=ai_gateway_api_key:/etc/model-gateway/creds/ai_gateway_api_key.cred
LoadCredentialEncrypted=openrouter_api_key:/etc/model-gateway/creds/openrouter_api_key.cred
LoadCredentialEncrypted=google_generative_ai_api_key:/etc/model-gateway/creds/google_generative_ai_api_key.cred
LoadCredentialEncrypted=cohere_api_key:/etc/model-gateway/creds/cohere_api_key.cred
LoadCredentialEncrypted=openai_api_key:/etc/model-gateway/creds/openai_api_key.cred

# Endurecido: sin elevation, sin escritura salvo en su estado/caché, sin caps,
# /home invisible para el UID transitorio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
