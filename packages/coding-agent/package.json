{
  "name": "coding-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./attached-files": "./src/attached-files.ts",
    "./event-log": "./src/event-log.ts",
    "./file-reference-prompt": "./src/file-reference-prompt.ts",
    "./http-transport": "./src/transports/http.ts",
    "./message-ids": "./src/message-ids.ts",
    "./models": "./src/models.ts",
    "./paths": "./src/paths.ts",
    "./pi-packages": "./src/pi-packages.ts",
    "./pi-to-agui-translator": "./src/pi-to-agui-translator.ts",
    "./reconnect-prelude": "./src/reconnect-prelude.ts",
    "./replay-compaction": "./src/replay-compaction.ts",
    "./session-manager": "./src/session-manager.ts",
    "./subagent-collector": "./src/subagent-collector.ts",
    "./transports/http": "./src/transports/http.ts",
    "./turn-git-state": "./src/turn-git-state.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.3",
    "models": "workspace:*",
    "tracing": "workspace:*",
    "typebox": "1.1.38"
  },
  "scripts": {
    "dev": "pnpm run transport:http",
    "start": "pnpm run transport:http",
    "packages:install": "tsx scripts/install-packages.ts",
    "transport:http": "tsx scripts/install-packages.ts && tsx scripts/generate-models.ts && tsx src/transports/http.ts",
    "type:check": "tsc --noEmit --pretty false",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
