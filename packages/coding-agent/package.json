{
  "name": "coding-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./artifacts": "./src/artifacts/artifacts.ts",
    "./artifacts-http": "./src/artifacts/artifacts-http.ts",
    "./attached-files": "./src/runtime/attached-files.ts",
    "./event-log": "./src/agui/event-log.ts",
    "./file-reference-prompt": "./src/runtime/file-reference-prompt.ts",
    "./http-transport": "./src/transports/http.ts",
    "./message-ids": "./src/agui/message-ids.ts",
    "./models": "./src/runtime/models.ts",
    "./paths": "./src/runtime/paths.ts",
    "./pi-packages": "./src/runtime/pi-packages.ts",
    "./pi-to-agui-translator": "./src/agui/pi-to-agui-translator.ts",
    "./reconnect-prelude": "./src/agui/reconnect-prelude.ts",
    "./replay-compaction": "./src/agui/replay-compaction.ts",
    "./session-manager": "./src/session/session-manager.ts",
    "./subagent-collector": "./src/subagent/subagent-collector.ts",
    "./transports/http": "./src/transports/http.ts",
    "./turn-git-state": "./src/session/turn-git-state.ts",
    "./agui/event-log": "./src/agui/event-log.ts",
    "./agui/event": "./src/agui/agui-event.ts",
    "./agui/agui-messages": "./src/agui/agui-messages.ts",
    "./agui/message-ids": "./src/agui/message-ids.ts",
    "./agui/pi-to-agui-translator": "./src/agui/pi-to-agui-translator.ts",
    "./agui/reconnect-prelude": "./src/agui/reconnect-prelude.ts",
    "./agui/replay-compaction": "./src/agui/replay-compaction.ts",
    "./session/session-manager": "./src/session/session-manager.ts",
    "./session/session-entry": "./src/session/session-entry.ts",
    "./session/session-registry": "./src/session/session-registry.ts",
    "./session/session-queries": "./src/session/session-queries.ts",
    "./session/turn-runner": "./src/session/turn-runner.ts",
    "./session/turn-git-state": "./src/session/turn-git-state.ts",
    "./subagent/subagent-bridge": "./src/subagent/subagent-bridge.ts",
    "./subagent/subagent-collector": "./src/subagent/subagent-collector.ts",
    "./artifacts/artifacts": "./src/artifacts/artifacts.ts",
    "./artifacts/artifacts-http": "./src/artifacts/artifacts-http.ts",
    "./runtime/attached-files": "./src/runtime/attached-files.ts",
    "./runtime/file-reference-prompt": "./src/runtime/file-reference-prompt.ts",
    "./runtime/models": "./src/runtime/models.ts",
    "./runtime/paths": "./src/runtime/paths.ts",
    "./runtime/pi-packages": "./src/runtime/pi-packages.ts",
    "./runtime/prompts": "./src/runtime/prompts.ts",
    "./runtime/runtime-factory": "./src/runtime/runtime-factory.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "config": "workspace:*",
    "inference": "workspace:*",
    "models": "workspace:*",
    "nunjucks": "^3.2.4",
    "tracing": "workspace:*",
    "typebox": "1.1.38"
  },
  "scripts": {
    "dev": "tsx scripts/install-packages.ts && tsx scripts/generate-models.ts && tsx src/transports/http.ts",
    "lint": "eslint src scripts extensions tests --config ../../eslint.config.mjs",
    "lint:fix": "eslint --fix src scripts extensions tests --config ../../eslint.config.mjs",
    "build": "tsx scripts/assert-prod-build-allowed.ts && tsc -p tsconfig.json --outDir dist && dotenv -o -e ../../.env.prod -- tsx scripts/generate-models.ts",
    "build:verify": "tsc -p tsconfig.json --outDir dist/verify && CODING_AGENT_MODELS_JSON=.pi-verify/models.json tsx scripts/generate-models.ts",
    "preview": "dotenv -o -e ../../.env.prod -- sh -c 'ALLOW_PROD_BUILD=1 pnpm run build && node --import tsx dist/transports/http.js'",
    "stop:dev": "sh -c 'lsof -ti:3016 | xargs -r kill 2>/dev/null || true; echo \"worker dev (3016) stopped\"'",
    "stop:test": "sh -c 'echo \"test uses stub on 3001, no worker dev to stop\"'",
    "packages:install": "tsx scripts/install-packages.ts",
    "type:check": "tsc --noEmit --pretty false",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:all": "vitest run",
    "test:unit:watch": "vitest tests/unit"
  },
  "devDependencies": {
    "@types/nunjucks": "^3.2.6",
    "dotenv-cli": "^11.0.0",
    "vitest": "^4.0.18"
  }
}
