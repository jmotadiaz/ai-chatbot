# ai-chatbot — variables de entorno (ADR 0010, Model Gateway desacoplado).
#
# El catálogo completo y tipado vive en packages/config/src/catalog.ts
# (acceso vía `config`). Las API keys de los proveedores de IA NO van aquí:
# las custodia el Model Gateway cifradas con systemd-creds
# (packages/model-gateway/scripts/manage-creds.sh).

# --- Secretos ---

# DSN de la base de datos Postgres (5433 dev / 5434 test / 5435 prod).
POSTGRES_URL=""

# API key del Model Gateway (bearer de /v1/*). En test es la del Mock Model
# Gateway (:4001).
MODEL_GATEWAY_API_KEY=""

# API key de Exa Search (EXA_API_KEY es su alias legacy).
EXASEARCH_API_KEY=""
EXA_API_KEY=""

# API key de autenticación del mcp-server.
MCP_API_KEY=""

# Secreto de auth.js.
AUTH_SECRET=""

# --- Model Gateway (único proveedor de IA) ---

# dev/prod → Gateway real (systemd, :4000); test → Mock Model Gateway (:4001).
MODEL_GATEWAY_URL="http://127.0.0.1:4000"

# --- Configuración ---

# Confía en el host para auth.js (necesario detrás de proxy/nginx).
AUTH_TRUST_HOST=true

# Activa el agente de código y su worker (coding-agent).
CODING_AGENT_ENABLED=true
CODING_AGENT_PROJECTS_ROOT=""
CODING_AGENT_SESSIONS_DIR=""
