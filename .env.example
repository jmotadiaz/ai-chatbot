# Database credentials (host, port, and db name are defined per Environment in packages/config/src/config.<env>.ts)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Model Gateway master key
MODEL_GATEWAY_API_KEY=replace-with-the-gateway-master-key

# NextAuth secret (long random string, e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Exa Search API key (web search chat mode)
EXA_API_KEY=replace-with-exa-api-key

# Context7 API key (context7 chat mode)
CONTEXT7_API_KEY=replace-with-context7-api-key

# Built-in MCP Server personal API key (optional, client credential for stdio mcp-server)
# MCP_API_KEY=
