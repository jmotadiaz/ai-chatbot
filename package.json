{
  "name": "ai-chatbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter chatbot dev",
    "build": "pnpm --filter chatbot build",
    "build:worker": "tsc --noEmit packages/coding-agent/*.ts",
    "start": "pnpm --filter chatbot start",
    "preview": "dotenv -e .env.development.local -- sh -c 'pnpm --filter chatbot db:start && pnpm --filter chatbot build && concurrently \"pnpm --filter chatbot start\" \"pnpm worker:dev\"'",
    "agent:start": "export NEXT_PUBLIC_ENV=test && pnpm --filter chatbot db:test:start && pnpm --filter chatbot db:migrate && pnpm --filter chatbot db:seed && NODE_ENV=test pnpm --filter chatbot dev",
    "jules:start": "export NEXT_PUBLIC_ENV=test && pnpm --filter chatbot db:jules:start && pnpm --filter chatbot db:migrate && pnpm --filter chatbot db:seed && NODE_ENV=test pnpm --filter chatbot dev",
    "db:generate": "pnpm --filter chatbot db:generate",
    "db:push": "pnpm --filter chatbot db:push",
    "db:migrate": "pnpm --filter chatbot db:migrate",
    "db:seed": "pnpm --filter chatbot db:seed",
    "db:start": "pnpm --filter chatbot db:start",
    "db:stop": "pnpm --filter chatbot db:stop",
    "db:test:start": "pnpm --filter chatbot db:test:start",
    "db:test:stop": "pnpm --filter chatbot db:test:stop",
    "db:jules:start": "pnpm --filter chatbot db:jules:start",
    "db:jules:stop": "pnpm --filter chatbot db:jules:stop",
    "db:logs": "pnpm --filter chatbot db:logs",
    "lint": "pnpm --filter chatbot lint",
    "lint:fix": "pnpm --filter chatbot lint:fix",
    "type:check": "pnpm --filter chatbot type:check",
    "test": "concurrently \"npm run test:e2e\" \"npm run test:unit\"",
    "eval": "pnpm --filter chatbot eval",
    "test:e2e": "pnpm --filter chatbot test:e2e",
    "test:e2e:ui": "pnpm --filter chatbot test:e2e:ui",
    "test:e2e:headed": "pnpm --filter chatbot test:e2e:headed",
    "test:e2e:jules": "pnpm --filter chatbot test:e2e:jules",
    "mcp:start": "pnpm --filter chatbot mcp:start",
    "mcp-server": "pnpm --filter chatbot mcp-server",
    "worker:dev": "dotenv -e .env.development.local -- tsx packages/coding-agent/worker.ts",
    "test:unit": "pnpm --filter chatbot test:unit",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4"
  }
}
