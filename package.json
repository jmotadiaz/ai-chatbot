{
  "name": "ai-chatbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "dotenv -e .env.dev -- pnpm --filter chatbot --filter coding-agent --parallel dev",
    "build": "dotenv -e .env.dev -- pnpm --filter chatbot build",
    "build:prod": "pnpm --filter chatbot build:prod && pnpm --filter coding-agent build:prod",
    "build:prod:verify": "pnpm --filter chatbot build:prod:verify && pnpm --filter coding-agent build:prod:verify",
    "build:worker": "tsc -p packages/coding-agent/tsconfig.json --noEmit",
    "start": "dotenv -e .env.dev -- pnpm --filter chatbot --filter coding-agent --parallel start",
    "preview": "dotenv -o -e .env.prod -- pnpm --filter chatbot --filter coding-agent --parallel preview",
    "stop:dev": "pnpm --filter chatbot stop:dev && pnpm --filter coding-agent stop:dev",
    "stop:test": "pnpm --filter chatbot stop:test && pnpm --filter coding-agent stop:test",
    "db:generate": "pnpm --filter chatbot db:generate",
    "db:push": "pnpm --filter chatbot db:push",
    "db:dev:start": "pnpm --filter chatbot db:dev:start",
    "db:dev:stop": "pnpm --filter chatbot db:dev:stop",
    "db:test:start": "pnpm --filter chatbot db:test:start",
    "db:test:stop": "pnpm --filter chatbot db:test:stop",
    "db:prod:start": "pnpm --filter chatbot db:prod:start",
    "db:prod:stop": "pnpm --filter chatbot db:prod:stop",
    "db:dev:logs": "pnpm --filter chatbot db:dev:logs",
    "db:test:logs": "pnpm --filter chatbot db:test:logs",
    "db:prod:logs": "pnpm --filter chatbot db:prod:logs",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "type:check": "pnpm -r --if-present run type:check",
    "test": "pnpm test:fast",
    "eval": "pnpm --filter chatbot eval",
    "test:e2e": "pnpm --filter chatbot test:e2e",
    "test:e2e:ui": "pnpm --filter chatbot test:e2e:ui",
    "test:e2e:headed": "pnpm --filter chatbot test:e2e:headed",
    "mcp:start": "pnpm --filter chatbot mcp:start",
    "mcp-server": "pnpm --filter chatbot mcp-server",
    "transport:http": "dotenv -o -e .env.dev -- pnpm --filter coding-agent dev",
    "worker:dev": "pnpm transport:http",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:component": "pnpm -r --if-present run test:component",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:contract": "pnpm -r --if-present run test:contract",
    "test:fast": "pnpm test:unit && pnpm test:component && pnpm test:integration && pnpm test:contract",
    "verify:fast": "pnpm lint && pnpm type:check && pnpm test:fast",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.24.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
